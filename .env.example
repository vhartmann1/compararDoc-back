ANTHROPIC_API_KEY=
# auto | claude | mock | claude_code  (auto = claude se houver chave, senão mock; claude_code = CLI do Claude Code, só teste local)
EXTRATOR_MODO=auto
MODELO_CLAUDE=claude-opus-5-5
# Postgres (padrão = o do docker-compose.yaml)
DATABASE_URL=postgresql+psycopg://comparardocs:comparardocs@localhost:5432/comparardocs
# MongoDB (padrão = o do docker-compose.yaml)
MONGO_URL=mongodb://comparardocs_app:comparardocs_app@localhost:27017/?authSource=comparardocs
MONGO_DB=comparardocs
